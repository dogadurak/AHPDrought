# --- Ortam ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# --- Veri (Git LFS kullanılmıyor: ham ve ara veri repoya girmez) ---
data/raw/**
data/processed/**
data/interim/**
# Dizinlerin kendisi hariç tutulmamalı, yoksa git içlerine inip aşağıdaki
# istisnaları göremez.
!data/**/
!data/**/.gitkeep
!data/processed/aoi.geojson
!data/processed/grid_definition.json

# --- Büyük çıktılar ---
outputs/**/*.tif
outputs/**/*.tiff
outputs/**/*.mp4
outputs/**/*.nc
outputs/**/*.zarr/
!outputs/**/.gitkeep

# Animasyonun ara kareleri repoya girmesin (GIF'in kendisi girer)
outputs/figures/_frames/

# osmnx'in Overpass yanıt önbelleği (proje kökünde açılır, ~7 MB)
cache/

# README'ye gömülecek küçük görseller repoda kalsın:
!outputs/figures/**/*.png
!outputs/figures/**/*.gif

# --- Sistem ---
.DS_Store
Thumbs.db
.vscode/
.idea/
